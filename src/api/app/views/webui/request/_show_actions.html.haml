- content_for :actions do
  = render partial: 'webui/shared/lock_unlock_comment', locals: { commentable: bs_request }
  - if User.session && policy(Report.new(reportable: bs_request)).create?
    = render partial: 'webui/request/report_request', locals: { bs_request: bs_request }
  - elsif !User.session && Flipper.enabled?(:content_moderation)
    %li.nav-item
      = link_to_require_login(css_class: 'nav-link') do
        %i.fas.fa-regular.fa-flag.fa-fw.me-2
        %span.nav-item-name Report Request
