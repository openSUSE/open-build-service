.modal.fade{ id: modal_id, tabindex: -1, role: 'dialog', aria: { labelledby: 'confirm-modal-label', hidden: true } }
  .modal-dialog.modal-dialog-centered{ role: 'document' }
    .modal-content
      .modal-header
        %h5.modal-title#confirm-modal-label
          #{entity_type} Maintainers
      .modal-body
        -# Edge case: maintainers can be users or groups; render each with its appropriate icon and link
        - maintainers.each do |maintainer|
          %p
            - if maintainer.is_a?(Group)
              = group_with_icon(maintainer)
            - else
              = user_with_realname_and_icon(maintainer, short: true)
        .modal-footer
          %button.btn.btn-sm.btn-outline-secondary.px-4{ data: { 'bs-dismiss': 'modal' } }
            OK
