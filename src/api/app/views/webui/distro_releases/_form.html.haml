= form_with(url: url, model: model) do |form|
  .mb-3
    = form.label :name
    = form.text_field :name, class: 'form-control'

  .mb-3
    = form.label :description
    - preview_url = preview_description_project_distro_releases_path(model.distro.vendor.project, model.distro.name)
    = render WriteAndPreviewComponent.new(form: form, preview_message_url: preview_url,
                                          message_body_param: 'distro_release[description]',
                                          text_area_rows: 8,
                                          text_area_required: false,
                                          text_area_object_name: :description)

  .mb-3
    = form.label :url
    = form.text_field :url, class: 'form-control'

    = render partial: 'webui/distro_release_repository_architectures/form', locals: { form: form, model: model }

  %div
    = link_to('Cancel', project_distro_path(model.distro.vendor.project, model.distro.name), title: 'Cancel',
              class: 'btn btn-outline-secondary px-4 me-3 mt-3 mt-sm-0')
    = form.submit 'Save', class: 'btn btn-success'


