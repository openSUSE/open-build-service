- release_path = project_distro_release_path(distro_release.project, distro_release.distro, distro_release)
= render(CardComponent.new) do |component|
  %p.card-text
    - if distro_release.url.present?
      %i.fas.fa-link.text-info
      = render partial: 'webui/shared/external_link', locals: { text: distro_release.url, url: distro_release.url }
  .card-text
    = render_without_markdown(truncate(distro_release.description, length: 100))
  %b.card-text
    Repositories:
  - repositories = distro_release.repository_architectures.group_by(&:repository)
  %ul.list-group.list-group-flush
    - repositories.first(2).each do |repository, repository_architectures|
      %li.list-group-item.d-flex.flex-wrap.justify-content-between.px-0
        #{repository.project.name}/#{repository.name}
        %div
          - repository_architectures.each do |ra|
            %span.badge.text-bg-primary
              = ra.architecture.name
    - if repositories.size > 2
      %li.list-group-item.px-0
        = link_to("+ #{pluralize(repositories.size - 2, 'more repository', plural: 'more repositories')}", release_path)
  - component.with_header do
    %h5.card-title= link_to distro_release.name, release_path

  - if policy(distro_release).destroy?
    - component.with_delete_button do
      = link_to '#', title: 'Delete distro release',
        data: { 'bs-toggle': 'modal', 'bs-target': '#delete-distro-release-modal', distro_release_name: distro_release.name,
                distro_name: distro_release.distro.name, action: release_path } do
        %i.fas.fa-times-circle.text-danger
  - if policy(distro_release).edit?
    - edit_release_path = edit_project_distro_release_path(distro_release.project, distro_release.distro, distro_release)
    = link_to(edit_release_path, class: 'ps-2', title: 'Edit distro release') do
      %i.fas.fa-edit
      %span.nav-item-name Edit
