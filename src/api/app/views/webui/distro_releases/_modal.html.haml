= render ModalComponent.new(modal_id: "distro-release-#{model.id}",
                            modal_button_data: {text: text, type: 'link text-decoration-none', icon: icon}) do |component|
  - component.with_header do
    = text
  = form_with(url: url, model: model) do |form|
    .mb-3
      = form.label :name
      = form.text_field :name, class: 'form-control'

    .mb-3
      = form.label :description
      = form.textarea :description, class: 'form-control'

    .mb-3
      = form.label :url
      = form.text_field :url, class: 'form-control'

    %div
      = form.submit 'Save', class: 'btn btn-success'
