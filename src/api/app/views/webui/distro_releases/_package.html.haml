.list-group-item.d-flex.justify-content-between
  %span
    = link_to package_show_path(package.project, package) do
      %b #{package.project.name}/#{package.name}
    - if Flipper.enabled?(:labels, User.session) && package.labels
      %span.ms-1
        = render partial: 'webui/shared/label', collection: package.labels, as: :label
  - if Flipper.enabled?(:package_version_tracking, User.session) && (package.latest_local_version || package.latest_upstream_version)
    %span
      - if package.latest_local_version
        %b= package.latest_local_version.version
