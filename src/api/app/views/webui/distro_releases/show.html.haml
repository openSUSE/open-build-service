- @pagetitle = "#{@distro.name} release #{@distro_release.name}"
- release_path = project_distro_release_path(@project, @distro, @distro_release)

.card.mb-3#distro
  .card-body.d-flex.flex-wrap.align-items-start.gap-3
    %i.fas.fa-ship.fa-3x.text-primary
    .flex-grow-1
      .small.text-secondary.text-uppercase.fw-semibold Release
      %h3.mb-1.text-word-break-all= @distro_release.name
      .text-secondary.mb-3
        of
        = link_to(@distro.name, project_distro_path(@vendor.project, @distro.name))
        by
        = link_to(@distro.vendor.name, project_vendor_path(@project))
        - if @distro_release.url.present?
          ·
          = render partial: 'webui/shared/external_link', locals: { text: @distro_release.url, url: @distro_release.url }
      #distro-release-description
        - if @distro_release.description.blank?
          %i.text-secondary No description set
        - else
          = render partial: 'webui/shared/collapsible_text', locals: { text: @distro_release.description, render_markdown: true }
    .d-flex.gap-2
      - if policy(@distro_release).edit?
        = link_to(edit_project_distro_release_path(@project, @distro, @distro_release), class: 'btn btn-sm btn-outline-secondary') do
          %i.fas.fa-edit
          Edit
      - if policy(@distro_release).destroy?
        %button.btn.btn-sm.btn-outline-danger{ type: 'button', data: { 'bs-toggle': 'modal', 'bs-target': '#delete-distro-release-modal' } }
          %i.fas.fa-trash-can
          Delete
.card
  .card-body
    %h3
      Repositories
    = turbo_frame_tag("distro-release-repositories-#{@distro_release.to_param}") do
      %ul.list-group.list-group-flush
        - @distro_release.repository_architectures.group_by(&:repository).each do |repository, repository_architectures|
          %li.list-group-item.d-flex.flex-wrap.justify-content-between.px-0
            #{repository.project.name}/#{repository.name}
            %div
              - repository_architectures.each do |ra|
                %span.badge.text-bg-primary
                  = ra.architecture.name
      - if policy(@distro_release).edit?
        = link_to(edit_project_distro_release_repositories_path(@project, @distro, @distro_release)) do
          %i.fas.fa-edit
          Edit repositories

    %h3.mt-4
      Lifecycle
    %ul.list-group.list-group-flush
      - @distro_release.distro_release_lifecycles.chronological.each do |lifecycle|
        = render partial: 'webui/distro_release_lifecycles/lifecycle', locals: { lifecycle: lifecycle }
    - new_lifecycle = DistroReleaseLifecycle.new(distro_release: @distro_release)
    - if policy(new_lifecycle).new?
      = render partial: 'webui/distro_release_lifecycles/modal',
               locals: { model: new_lifecycle,
                         url: project_distro_release_lifecycles_path(@project, @distro, @distro_release),
                         text: 'New Lifecycle', icon: 'circle-plus', type: 'link text-decoration-none ps-0' }
    %h3.mt-4
      Packages
    = form_for(:package, url: project_distro_release_path(@distro_release.project, @distro_release.distro, @distro_release),
               method: :get, id: 'content-selector-filters-form') do |form|
      .row
        .col-md-4.col-lg-3.px-0.px-md-3.sticky-top#filter-desktop
          .border-end
            %strong.d-block.d-md-none.p-3{ data: { 'bs-toggle': 'collapse', 'bs-target': '#content-selector-filters' },
                                           aria: { expanded: true, controls: 'filters' } }
              Filters
              %i.float-end.mt-1.fa.fa-chevron-down#packages-dropdown-trigger
            .collapse#content-selector-filters
              = render partial: 'package_filter', locals: { distro_release: @distro_release,
                                                            selected_filter: @selected_filter,
                                                            projects_for_filter: @projects_for_filter }
        .col-md-8.col-lg-9.px-0.px-md-3.content-list#projects-list
          .row.flex-row-reverse
            .col-md-4.mb-3
              .d-flex.align-items-center
                .me-2
                  = render partial: 'filter_help_search_box'
                .w-100
                  = render partial: 'webui/shared/search_box', locals: { html_id: 'search',
                                                                         value: @selected_filter[:search],
                                                                         required: false,
                                                                         button: { type: 'submit' },
                                                                         placeholder: 'Search' }
            .col-md-8.mb-3.text-center.text-md-start
              %span= page_entries_info @packages, entry_name: 'package'
          = render partial: 'packages_list', locals: { distro_release: @distro_release,
                                                       packages: @packages,
                                                       selected_filter: @selected_filter }

- if policy(@distro_release).destroy?
  - confirmation_text = "Please confirm deletion of the release '#{@distro_release.name}' of the distribution '#{@distro.name}'."
  = render DeleteConfirmationDialogComponent.new(modal_id: 'delete-distro-release-modal',
                                                 method: :delete,
                                                 options: { modal_title: 'Do you really want to delete this release?',
                                                            confirmation_text: confirmation_text,
                                                            action: release_path })
