= render partial: 'webui/vendors/breadcrumb_items'

- if controller_name == 'distro' && action_name == 'new'
  %li.breadcrumb-item.active{ 'aria-current' => 'page' }
    Create Distro
- else
  %li.breadcrumb-item.text-word-break-all
    %i.fa.fa-compact-disc
    = link_to @distro.name, project_distro_path(@distro.project, @distro.name)
