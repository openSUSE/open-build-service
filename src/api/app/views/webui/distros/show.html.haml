- @pagetitle = "Distribution #{@distro.name}"

.card.mb-3#distro
  .card-body.d-flex.flex-wrap.align-items-start.gap-3
    %i.fas.fa-compact-disc.fa-3x.text-primary
    .flex-grow-1
      .small.text-secondary.text-uppercase.fw-semibold Distribution
      %h3.mb-1.text-word-break-all= @distro.name
      .text-secondary.mb-3
        by
        %i.fas.fa-globe
        = link_to(@vendor.name, project_show_path(@project, anchor: 'vendor'))
        - if @distro.url.present?
          ·
          = render partial: 'webui/shared/external_link', locals: { text: @distro.url, url: @distro.url }
      #distro-description
        - if @distro.description.blank?
          %i.text-secondary No description set
        - else
          = render partial: 'webui/shared/collapsible_text', locals: { text: @distro.description, render_markdown: true }
    .d-flex.gap-2
      - if policy(@distro).update?
        %button.btn.btn-sm.btn-outline-secondary{ type: 'button', data: { 'bs-toggle': 'modal', 'bs-target': '#distro-form-modal' } }
          %i.fas.fa-edit
          Edit
      - if policy(@distro).destroy?
        %button.btn.btn-sm.btn-outline-danger{ type: 'button', data: { 'bs-toggle': 'modal', 'bs-target': '#delete-distro-modal' } }
          %i.fas.fa-trash-can
          Delete

= render partial: 'webui/distros/releases', locals: { project: @project, distro: @distro, distro_releases: @distro_releases,
                                                       selected_release: @distro_release }

- if policy(@distro).update?
  = render ModalComponent.new(modal_id: 'distro-form') do |component|
    - component.with_header do
      Edit Distribution
    = render partial: 'webui/distros/form', locals: { url: project_distro_path(@project, @distro.name), model: @distro, modal: true }
- if policy(@distro).destroy?
  - confirmation_text = "Please confirm deletion of the distribution '#{@distro.name}' and all of its releases."
  = render DeleteConfirmationDialogComponent.new(modal_id: 'delete-distro-modal',
                                                 method: :delete,
                                                 options: { modal_title: 'Do you really want to delete this distribution?',
                                                            confirmation_text: confirmation_text,
                                                            action: project_distro_path(@project, @distro.name) })

- content_for :ready_function do
  :plain
    // The release details are loaded in a Turbo frame, initialize their collapsible description
    document.addEventListener('turbo:frame-load', function () { setCollapsible(); });
