- @pagetitle = "Distribution #{@distro.name}"

.card

.card.mb-3#distro
  .card-body.d-flex.flex-wrap.align-items-start.gap-3
    - if @distro.logo.attached?
      = image_tag @distro.logo, class: 'img-thumbnail distro-logo-preview'
    - else
      %i.fas.fa-compact-disc.fa-3x.text-primary
    .flex-grow-1
      .small.text-secondary.text-uppercase.fw-semibold Distribution
      %h3.mb-1.text-word-break-all= @distro.name
      .text-secondary.mb-3
        by
        %i.fas.fa-globe
        = link_to(@vendor.name, project_show_path(@project, anchor: 'vendor'))
        - if @distro.url.present?
          ·
          = render partial: 'webui/shared/external_link', locals: { text: @distro.url, url: @distro.url }
      #distro-description
        - if @distro.description.blank?
          %i.text-secondary No description set
        - else
          = render partial: 'webui/shared/collapsible_text', locals: { text: @distro.description, render_markdown: true }
    .d-flex.gap-2
      - if policy(@distro).update?
        %button.btn.btn-sm.btn-outline-secondary{ type: 'button', data: { 'bs-toggle': 'modal', 'bs-target': '#distro-form-modal' } }
          %i.fas.fa-edit
          Edit
      - if policy(@distro).destroy?
        %button.btn.btn-sm.btn-outline-danger{ type: 'button', data: { 'bs-toggle': 'modal', 'bs-target': '#delete-distro-modal' } }
          %i.fas.fa-trash-can
          Delete

.card.mb-3
  .card-body
    %h5 Lifecycle
    = render partial: 'lifecycle_timeline', locals: { distro_releases: @distro_releases }
    %h3
      Releases of #{@distro.name}
    .row.mt-3
      - @distro_releases.each do |distro_release|
        .col-lg-3.col-md-4.col-sm-6.col-12.mb-3.d-grid
          = render partial: 'webui/distro_releases/release', locals: { distro_release: distro_release }
      .ps-0
        - if policy(DistroRelease.new(distro: @distro)).new?
          = link_to(new_project_distro_release_path(@project, @distro), class: 'ps-2') do
            %i.fas.fa-circle-plus.text-info
            %span.nav-item-name New Release
    - if @distro_releases.size >= 2
      .mt-4
        = render partial: 'webui/distro_releases/compare_form',
                 locals: { project: @project, distro: @distro, distro_releases: @distro_releases,
                           base_release: @distro_releases[-2], target_release: @distro_releases[-1] }

.modal.fade#delete-distro-release-modal{ tabindex: -1, role: 'dialog', aria: { labelledby: 'delete-distro-modal-label', hidden: true } }
  .modal-dialog.modal-dialog-centered{ role: 'document' }
    .modal-content
      .modal-header
        %h5.modal-title#delete-distro-modal-label Do you really want to delete this distro release?
      .modal-body
        %p
          Please confirm that you want to delete the
          = surround "'" do
            %span#distro-release-name
          distro release from the distro
          = surround "'" do
            %span#distro-name
        = form_tag nil, method: :delete do
          .modal-footer
            %a.btn.btn-sm.btn-outline-secondary.px-4{ data: { 'bs-dismiss': 'modal' } }
              Cancel
            %input.btn.btn-sm.btn-danger.px-4{ type: 'submit', name: 'commit', value: 'Delete', data: { disable: { with: 'Delete' } } }


- if policy(@distro).update?
  = render ModalComponent.new(modal_id: 'distro-form') do |component|
    - component.with_header do
      Edit Distribution
    = render partial: 'webui/distros/form', locals: { url: project_distro_path(@project, @distro.name), model: @distro, modal: true }
- if policy(@distro).destroy?
  - confirmation_text = "Please confirm deletion of the distribution '#{@distro.name}' and all of its releases."
  = render DeleteConfirmationDialogComponent.new(modal_id: 'delete-distro-modal',
                                                 method: :delete,
                                                 options: { modal_title: 'Do you really want to delete this distribution?',
                                                            confirmation_text: confirmation_text,
                                                            action: project_distro_path(@project, @distro.name) })
- content_for :ready_function do
  :plain
    $('#delete-distro-release-modal').on('show.bs.modal', function (event) {
      var link = $(event.relatedTarget);
      $(this).find('#distro-name').text(link.data('distro-name'));
      $(this).find('#distro-release-name').text(link.data('distro-release-name'));
      $(this).find('form').attr('action', link.data('action'));
    })
