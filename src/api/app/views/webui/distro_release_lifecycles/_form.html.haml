= form_with(url: url, model: model) do |form|
  .mb-3
    = form.label :name
    = form.text_field :name, class: 'form-control'

  .mb-3
    = form.label :date
    = form.date_field :date, class: 'form-control'

  .mb-3
    = form.label :status
    = form.select :status, DistroReleaseLifecycle.statuses.keys.map { |status| [status.humanize, status] }, {}, class: 'form-select'

  %div
    = form.submit 'Save', class: 'btn btn-success'
