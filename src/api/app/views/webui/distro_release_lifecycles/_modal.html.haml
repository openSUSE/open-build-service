- modal_id = model.persisted? ? "distro-release-lifecycle-#{model.id}" : "distro-release-#{model.distro_release_id}-new-lifecycle"
= render ModalComponent.new(modal_id: modal_id,
                            modal_button_data: {text: text, type: 'link text-decoration-none ps-0', icon: icon}) do |component|
  - component.with_header do
    = text
  = render partial: 'webui/distro_release_lifecycles/form', locals: { url: url, model: model }
