:ruby
  bs_request_actions = bs_request.bs_request_actions.to_a
  bs_request_actions_types = bs_request_actions.map(&:type).uniq

.list-group-item.list-group-item-action
  .row.flex-nowrap
    .col-auto
      .text-center
        - if bs_request_actions.count > 1
          %div{ title: "Multiple Actions: #{bs_request_actions_types.join(', ').humanize.titleize}" }
            - if bs_request_actions_types.count > 1
              %i.fas.fa-list-check.bold
            - else
              %i{ class: "#{action_type_icon(bs_request_actions_types.first)}", title: bs_request_actions_types.first.humanize.titleize }
            %br
            %small= bs_request_actions.count
        - else
          %div
            %i{ class: "#{action_type_icon(bs_request_actions_types.first)}", title: bs_request_actions_types.first.humanize.titleize }
    .col.col-with-icon
      .d-flex.mb-1
        .me-auto
          = link_to(request_show_path(bs_request.number), class: 'request-actions-summary-title') do
            = render BsRequestActionsSummaryComponent.new(bs_request:, show_versions: Flipper.enabled?(:package_version_tracking, User.session))
        = render BsRequestPriorityBadgeComponent.new(priority: bs_request.priority, css_class: 'mb-auto mx-2')
        = render BsRequestStateBadgeComponent.new(state: bs_request.state, css_class: 'mb-auto')
      - if Flipper.enabled?(:labels, User.session) && bs_request.labels
        .mb-1
          = render partial: 'webui/shared/label_clickable', collection: bs_request.labels, locals: { form: form }, as: :label
      .d-flex.gap-2.mb-2.small
        = link_to(request_show_path(bs_request.number), id: "request-heading#{bs_request.number}", class: 'flex-shrink-0') do
          = "##{bs_request.number}"
        .request-index-description.text-truncate
          = bs_request.description
      .text-end
        %span
          - if (creator = User.find_by_login(bs_request.creator))
            = link_to(user_path(creator)) do
              = render AvatarComponent.new(name: bs_request.creator, email: creator.email, custom_css: 'align-text-bottom')
              = bs_request.creator
          - else
            %i.fas.fa-user-slash
            %em= "A deleted user"
          created
          = render TimeComponent.new(time: bs_request.created_at)
        - if bs_request.comments_count.positive?
          %span.text-nowrap{ title: pluralize(bs_request.comments_count, 'comment') }
            %i.fas.fa-comment.ps-2
            = bs_request.comments_count
        - if bs_request.reviews_count.positive?
          %span.text-nowrap{ title: pluralize(bs_request.reviews_count, 'review') }
            %i.fas.fa-magnifying-glass.ps-2
            = bs_request.reviews_count
