= render partial: 'webui/project/breadcrumb_items'

- if controller_name == 'vendor' && action_name == 'new'
  %li.breadcrumb-item.active{ 'aria-current' => 'page' }
    Create Vendor
- else
  %li.breadcrumb-item.text-word-break-all.active{ 'aria-current' => 'page' }
    %i.fa.fa-globe
    = link_to @vendor.name, project_vendor_path(@vendor.project)
