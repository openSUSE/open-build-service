- @pagetitle = "Vendor #{@vendor.name}"

.card
  .card-body
    %h3.mb-3
      = render partial: 'webui/shared/external_link', locals: { text: @vendor.name, url: @vendor.url }
    .row
      .col-12.col-md-10.col-lg-8
        .row
          .col
            %label.fw-bold
              Description:
            %span
              = @vendor.description
        .row
          .col
            %label.fw-bold
              URL:
            %span
              = render partial: 'webui/shared/external_link', locals: { text: @vendor.url, url: @vendor.url }

    .row
      .col
        - if policy(Distro.new(vendor: @vendor)).new?
          = link_to('#', data: { 'bs-toggle': 'modal', 'bs-target': '#distro-modal--modal' }, class: '') do
            %i.fas.fa-circle-plus
            %span.nav-item-name New Distro
          = render ModalComponent.new(modal_id: 'distro-modal-') do |component|
            - component.with_header do
              New Distro
            = render partial: 'webui/distros/form', locals: { url: vendor_distros_path(@vendor), model: Distro.new(vendor: @vendor) }
        - if policy(@vendor).edit?
          = link_to(edit_project_vendor_path(@vendor.project), class: 'ps-2', title: 'Edit') do
            %i.fas.fa-edit
            %span.nav-item-name Edit
        - if policy(@vendor).destroy?
          = link_to(project_vendor_path(@vendor.project), method: :delete, class: 'ps-2 text-danger',
            data: { confirm: 'Are you sure you want to delete this vendor?'}) do
            %i.fas.fa-trash-can
            %span.nav-item-name Delete
    .row.mt-3
      - @vendor.distros.each do |distro|
        .col-lg-3.col-md-4.col-sm-6.col-12.mb-3
          = render partial: 'webui/distros/distro', locals: { distro: }

.modal.fade#delete-distro-modal{ tabindex: -1, role: 'dialog', aria: { labelledby: 'delete-distro-modal-label', hidden: true } }
  .modal-dialog.modal-dialog-centered{ role: 'document' }
    .modal-content
      .modal-header
        %h5.modal-title#delete-distro-modal-label Do you really want to delete this distro?
      .modal-body
        %p
          Please confirm that you want to delete the
          = surround "'" do
            %span#distro-name
          distro from the vendor
          = surround "'" do
            %span#vendor-name
        = form_tag nil, method: :delete do
          .modal-footer
            %a.btn.btn-sm.btn-outline-secondary.px-4{ data: { 'bs-dismiss': 'modal' } }
              Cancel
            %input.btn.btn-sm.btn-danger.px-4{ type: 'submit', name: 'commit', value: 'Delete', data: { disable: { with: 'Delete' } } }

- content_for :ready_function do
  :plain
    $('#delete-distro-modal').on('show.bs.modal', function (event) {
      var link = $(event.relatedTarget);
      $(this).find('#vendor-name').text(link.data('vendor-name'));
      $(this).find('#distro-name').text(link.data('distro-name'));
      $(this).find('form').attr('action', link.data('action'));
    })
