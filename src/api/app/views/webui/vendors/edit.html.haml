- @pagetitle = "Edit vendor #{@vendor.name}"
- content_for :title, "Editing vendor"

.card
  = render(partial: 'webui/project/tabs', locals: { project: @project })
  .card-body
    %h1 Editing vendor

    = render(partial: 'webui/vendors/form', locals: { vendor: @vendor, url: project_vendor_path(@project, @vendor) })

    %br

    %div
      = link_to "Back to vendor", project_vendor_path(@project, @vendor)
